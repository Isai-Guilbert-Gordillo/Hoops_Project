DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Genera un valor propio con: openssl rand -hex 32
JWT_SECRET="reemplazar-con-un-valor-largo-y-aleatorio"

# Almacenamiento de imágenes (logos/fotos). OBLIGATORIO en producción (Vercel
# tiene disco efímero). Copia el valor "API Environment variable" del dashboard
# de Cloudinary (Settings > API Keys). Si se deja vacío, las subidas se guardan
# en disco local (solo sirve para desarrollo).
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
