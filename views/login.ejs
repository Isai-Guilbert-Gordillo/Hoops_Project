<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Iniciar Sesión - Retro Hoops' }) %>
</head>
<body>

    <%- include('partials/header', { hideLogin: true }) %>

    <div class="container-narrow fade-in-up">
        <h1><span class="float-ball">🏀</span> INICIAR SESIÓN</h1>

        <form id="login-form">
            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <div style="position: relative;">
                    <input type="password" id="password" name="password" style="width: 100%; padding-right: 40px;" required>
                    <button type="button" id="toggle-pwd" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); background: none; border: none; cursor: pointer; font-size: 1.2rem; padding: 0;">
                        👁️
                    </button>
                </div>
            </div>

            <button type="submit" class="btn-submit">Entrar</button>
        </form>

        <a href="/registro.html" class="back-link">¿No tienes cuenta? Regístrate</a>
    </div>

    <script src="/js/nav.js"></script>
    <script src="/js/login.js"></script>
</body>
</html>
