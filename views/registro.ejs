<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Registro - Retro Hoops' }) %>
</head>
<body>

    <!-- Página de registro: header mínimo (solo logo), sin nav ni sesión. -->
    <header>
        <a href="/" class="logo">RETRO HOOPS</a>
    </header>

    <div class="container-narrow fade-in-up">
        <h1><span class="float-ball">🏀</span> CREAR CUENTA</h1>
        <form id="register-form">
            <div class="form-group">
                <label for="firstName">Nombre</label>
                <input type="text" id="firstName" name="firstName" required>
            </div>

            <div class="form-group">
                <label for="lastName">Apellido</label>
                <input type="text" id="lastName" name="lastName" required>
            </div>

            <div class="form-group">
                <label for="email">Correo Electrónico</label>
                <input type="email" id="email" name="email" required>
            </div>

            <div class="form-group">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" required>
            </div>

            <button type="submit" class="btn-submit">Registrarse</button>
        </form>
        <a href="/login.html" class="back-link">¿Ya tienes cuenta? Inicia sesión</a>
    </div>

    <script src="/js/registro.js"></script>
</body>
</html>
