<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: 'Restablecer contraseña - Retro Hoops' }) %>
</head>
<body>

    <%- include('partials/header', { hideLogin: true }) %>

    <div class="container-narrow fade-in-up">
        <h1><span class="float-ball">🏀</span> NUEVA CONTRASEÑA</h1>

        <% if (!token) { %>
            <p>El enlace no es válido. Solicita uno nuevo desde la app.</p>
        <% } else { %>
            <form id="reset-form">
                <input type="hidden" id="token" value="<%= token %>">
                <div class="form-group">
                    <label for="password">Nueva contraseña</label>
                    <input type="password" id="password" name="password" minlength="<%= minLength %>"
                           placeholder="Mínimo <%= minLength %> caracteres" required>
                </div>
                <div class="form-group">
                    <label for="confirm">Confirmar contraseña</label>
                    <input type="password" id="confirm" name="confirm" required>
                </div>
                <button type="submit" class="btn-submit">Guardar</button>
            </form>
            <p id="msg" style="margin-top: 1rem;"></p>

            <script src="/js/reset-password.js"></script>
        <% } %>
    </div>

    <script src="/js/nav.js"></script>
</body>
</html>
