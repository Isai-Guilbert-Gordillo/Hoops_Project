<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', { title: "Perfil Franquicia - Retro Hoops", pageCss: "/css/equipo.css" }) %>
</head>
<body>

    <%- include('partials/header') %>

    <div class="container">
        <!-- Team Hero Section -->
        <div class="team-hero card fade-in-up" id="team-hero" style="display: none;">
            <div class="team-logo-hero" id="team-logo"></div>
            <div class="team-details">
                <h1 id="team-name" class="page-title">Cargando...</h1>
                <p>Capitán: <span class="captain" id="team-captain">---</span></p>
                <p>Fundación: <span id="team-date">---</span></p>
            </div>
        </div>

        <div id="error-message" style="color: var(--orange); display: none; text-align: center; margin: 3rem 0; font-size: 1.2rem;"></div>

        <!-- Roster Section -->
        <div id="roster-section" style="display:none;" class="reveal">
            <h2 class="section-title">🏀 Roster Oficial</h2>
            <div class="table-wrap">
                <table class="kp-table roster-table">
                    <thead>
                        <tr>
                            <th style="width: 100px;">Dorsal</th>
                            <th>Jugador</th>
                            <th>Posición</th>
                            <th id="roster-actions-header" style="width: 90px; display: none;"></th>
                        </tr>
                    </thead>
                    <tbody id="roster-body">
                        <!-- Filas de jugadores insertadas dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Inscripción en Torneos (solo visible para el capitán) -->
        <div id="enroll-section" class="reveal" style="display:none; margin-bottom: 2rem;">
            <h2 class="section-title">🏆 Inscribirse en Torneos</h2>

            <div id="enrolled-tournaments-wrap" style="display:none; margin-bottom: 1.5rem;">
                <p style="color: var(--text-muted); margin-bottom: 0.75rem;">Ya participas en:</p>
                <div class="cards-grid" id="enrolled-tournaments-list"></div>
            </div>

            <p style="color: var(--text-muted); margin-bottom: 0.75rem;">Torneos disponibles para inscribir a tu equipo:</p>
            <div class="cards-grid" id="available-tournaments-list">
                <p style="color: var(--text-muted); grid-column: 1 / -1;">Cargando torneos...</p>
            </div>
            <div id="enroll-msg" class="message-box"></div>
        </div>

        <!-- Add Player Form -->
        <div class="add-player-wrapper card reveal" id="add-player-section">
            <h3>Gestión de Franquicia</h3>
            <p style="color: var(--text-muted); margin-top: 0;">Como capitán, puedes registrar los jugadores oficiales de tu equipo.</p>
            <form id="addPlayerForm">
                <div class="form-row">
                    <div class="form-group" style="flex: 2;">
                        <label for="playerName">Nombre del Jugador</label>
                        <input type="text" id="playerName" required placeholder="Ej. Michael Jordan">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label for="jerseyNumber">Dorsal (#)</label>
                        <input type="number" id="jerseyNumber" required min="0" max="99" placeholder="23">
                    </div>
                    <div class="form-group" style="flex: 1;">
                        <label for="position">Posición</label>
                        <select id="position" required>
                            <option value="Base (PG)">Base (PG)</option>
                            <option value="Escolta (SG)">Escolta (SG)</option>
                            <option value="Alero (SF)">Alero (SF)</option>
                            <option value="Ala-Pívot (PF)">Ala-Pívot (PF)</option>
                            <option value="Pívot (C)">Pívot (C)</option>
                        </select>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group" style="flex: 2; display: flex; align-items: center; gap: 1rem;">
                        <div style="flex: 1;">
                            <label for="playerPhoto">Foto (opcional)</label>
                            <input type="file" id="playerPhoto" accept="image/*">
                        </div>
                        <div class="player-photo" id="playerPhotoPreview" style="display: none;"></div>
                    </div>
                    <button type="submit" class="btn-submit" style="width: auto; margin-top: 0;">Añadir Jugador</button>
                </div>
            </form>
            <div id="form-msg" class="message-box"></div>
        </div>
    </div>

    <!-- Ventana flotante de confirmación para eliminar un jugador: centrada,
         con fondo desenfocado (misma clase compartida .modal-overlay/.modal-box). -->
    <div class="modal-overlay" id="delete-player-modal" style="display: none;">
        <div class="modal-box" style="max-width: 420px;">
            <div class="modal-header">
                <h3 class="modal-title">Eliminar Jugador</h3>
                <button type="button" class="modal-close-btn" id="delete-player-close" aria-label="Cerrar">&times;</button>
            </div>
            <p style="color: var(--text-muted); margin: 0 0 1.5rem;">¿Estás seguro de que deseas eliminar a <strong id="delete-player-name" style="color: var(--text-main);"></strong> del roster? Esta acción no se puede deshacer.</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-danger" id="delete-player-confirm"><span class="btn-content">Eliminar</span></button>
                <button type="button" class="btn btn-ghost" id="delete-player-cancel"><span class="btn-content">Cancelar</span></button>
            </div>
        </div>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/nav.js"></script>
    <script src="/js/equipo.js"></script>
</body>
</html>
