<%#
  Cabeza común a todas las páginas: charset/viewport, fuentes del theme
  (Outfit + Press Start 2P), theme.css y toast.js.
  Locals:
    - title (string, requerido)
    - description (string, opcional)
    - pageCss (string | string[], opcional) → hoja(s) de estilo de la página
%>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<% if (typeof description !== 'undefined' && description) { %>
<meta name="description" content="<%= description %>">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700;800&family=Press+Start+2P&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/theme.css">
<% (typeof pageCss === 'undefined' ? [] : [].concat(pageCss)).forEach(function (href) { %>
<link rel="stylesheet" href="<%= href %>">
<% }) %>
<script src="/toast.js"></script>
